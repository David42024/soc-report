# Demo local: SQLite + reglas de ejemplo + enrutamiento local.
DATABASE_URL=
SQLITE_PATH=soc.sqlite3
CLASSIFIER_MODE=demo
ROUTER_MODE=local
OPERATOR_TOKEN=demo-operador

# Integrado: configura DATABASE_URL y cambia los modos a langflow y n8n.
# DATABASE_URL=postgresql://soc_router:CONTRASENA@127.0.0.1:5432/soc_reports
LANGFLOW_URL=http://127.0.0.1:7860
LANGFLOW_FLOW_ID=
LANGFLOW_API_KEY=
LANGFLOW_TIMEOUT_SECONDS=90
N8N_WEBHOOK_URL=http://127.0.0.1:5678/webhook/soc-assign-report
N8N_WEBHOOK_TOKEN=
INTERNAL_TOKEN=

# Plataforma común
JWT_SECRET=
TOTP_ENCRYPTION_KEY=
JWT_MINUTES=60
LEGACY_OPERATOR_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379/0
LOGIN_LIMIT=10
REPORT_LIMIT=60
# Windows, reutiliza las DLL de Tesseract si están instaladas.
WEASYPRINT_DLL_DIRECTORIES=C:/Program Files/Tesseract-OCR

# Chat conversacional (claves solo en el servidor)
GROQ_API_KEY=
GEMINI_API_KEY=
CHAT_GROQ_MODEL=openai/gpt-oss-20b
CHAT_GEMINI_MODEL=gemini-3-flash-preview
CHAT_TIMEOUT_SECONDS=25
CHAT_LIMIT=20

# Obligatorio antes del egreso cloud. Un archivo ausente o inválido bloquea el envío.
# Ruta relativa a la raíz del proyecto; no contiene secretos ni datos personales.
SOC_PRIVACY_POLICY=config/privacy.yaml

# Streamlit analítico: reutiliza FastAPI, JWT/RBAC y las fuentes del proyecto.
# Las claves Groq/Gemini continúan únicamente en los mecanismos del servidor.
SOC_API_URL=http://127.0.0.1:8000
SOC_ANALYTICS_CONFIG=config/analytics.yaml
SOC_ANALYTICS_HOST=127.0.0.1
SOC_ANALYTICS_PORT=8502
SOC_ANALYTICS_LOG_LEVEL=INFO

# Fase 2: techo verificable por ejecución LangFlow, incluyendo intentos de respaldo.
# Cero mantiene las llamadas experimentales deshabilitadas. La sesión autoriza cada presupuesto.
SOC_EXPERIMENT_MAX_COST_PER_FLOW_USD=0
SOC_EXPERIMENT_MAX_RUN_BUDGET_USD=0
